[Unit]
Description=Laplace: the daily digest of the record
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/laplace/deploy/engine
EnvironmentFile=%h/laplace/secrets/engine.env
ExecStart=%h/laplace/deploy/engine/.venv/bin/laplace-engine digest --data %h/laplace/live
TimeoutStartSec=5min
